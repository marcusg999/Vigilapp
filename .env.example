# ---------------------------------------------------------------------------
# Vigil — environment variables
# Copy to `.env.local` and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API)
# Safe to expose to the browser — RLS constrains everything the anon key can do.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key — SERVER ONLY. Bypasses RLS. Used solely for the admin audit
# log and true account deletion. Must never appear in client code / the bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API — SERVER ONLY. The persona is called exclusively from
# server routes; this key must never be exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Model used for the echo persona. Defaults to Claude Opus 5 in code; override
# here (e.g. claude-sonnet-5) if you want a faster/cheaper model for chat.
ANTHROPIC_MODEL=claude-opus-5

# Public site URL, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
